{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firebase-config.json",
  "auth": {
    "providers": {
      "anonymous": false,
      "emailPassword": false,
      "googleSignIn": {
        "oAuthBrandDisplayName": "RetroStore",
        "supportEmail": "saschah@gmail.com",
        "authorizedRedirectUris": [
          "https://retrostore-admin-candidate-zzch7qgr2a-uc.a.run.app",
          "https://retrostore-admin-candidate-760396810462.us-central1.run.app",
          "https://admin-next.retrostore.org"
        ]
      }
    }
  },
  "hosting": [
    {
      "target": "retrostore-public",
      "public": "infra/public-site/dist",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        }
      ]
    }
  ]
}
