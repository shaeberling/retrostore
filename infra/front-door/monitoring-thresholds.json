{
  "schema_version": 1,
  "status": "cutover_policy_approved_monitoring_defaults_provisional",
  "last_verified": "2026-08-10",
  "comparison": {
    "schedule_seconds": 3600,
    "minimum_consecutive_zero_diff_reports": 3,
    "maximum_unexplained_differences": 0,
    "maximum_unapproved_differences": 0,
    "material_fix_restarts_evidence_streak": true,
    "report_retention_days": 90
  },
  "integrity": {
    "maximum_missing_documents": 0,
    "maximum_missing_objects": 0,
    "maximum_checksum_mismatches": 0,
    "maximum_broken_references": 0,
    "maximum_duplicate_ids": 0,
    "active_snapshot_must_be_ready": true
  },
  "availability": {
    "window_seconds": 300,
    "minimum_requests_for_rate_trigger": 100,
    "maximum_unexpected_5xx_count_below_minimum": 4,
    "maximum_5xx_ratio": 0.01,
    "maximum_5xx_ratio_delta_from_app_engine": 0.0025,
    "readiness_success_ratio": 1.0
  },
  "latency": {
    "window_seconds": 900,
    "minimum_requests": 100,
    "p95_maximum_baseline_multiplier": 2.0,
    "p95_maximum_baseline_delta_ms": 250,
    "p99_maximum_baseline_multiplier": 2.0,
    "p99_maximum_baseline_delta_ms": 500
  },
  "cutover": {
    "mode": "single_atomic_switch_after_parallel_parity_and_operator_approval",
    "percentage_canaries_enabled": false,
    "minimum_observation_hours": 0,
    "require_complete_comparator_before_cutover": true,
    "require_full_public_transport_parity_before_cutover": true,
    "require_app_engine_fallback_parity_before_cutover": true,
    "require_native_port_80_smoke_before_cutover": true,
    "require_all_consumer_smokes_before_cutover": true,
    "state_split_traffic_allowed": false,
    "admin_writer_split_traffic_allowed": false
  },
  "rollback": {
    "target_route_recovery_minutes": 5,
    "automatic_route_rollback_triggers": [
      "unexplained_contract_difference",
      "data_integrity_failure",
      "availability_threshold_breach",
      "latency_threshold_breach",
      "client_compatibility_failure"
    ],
    "manual_immediate_stop_triggers": [
      "security_incident",
      "possible_data_loss",
      "single_writer_invariant_violation",
      "state_token_allocation_collision"
    ]
  },
  "post_cutover": {
    "fixed_minimum_wait_required": false,
    "continue_comparator": true,
    "immediate_rollback_on_gate_failure": true
  }
