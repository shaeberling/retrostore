{
  "name": "projects/760396810462/dashboards/retrostore-migration",
  "displayName": "RetroStore migration candidates",
  "labels": {
    "playbook": ""
  },
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 12,
        "height": 2,
        "widget": {
          "title": "Migration gates",
          "text": {
            "format": "MARKDOWN",
            "content": "Private candidates only. Hourly gate: API 158 + downloads 94 + website catalog 32 + redirects 6, with zero unexplained differences. The separate HTTP/HTTPS gate covers 338 public reads. Read canaries only; state and admin writer handoffs are atomic. Card and TRS-IO remain on App Engine."
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Candidate request rate by service/status",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" (resource.label.\"service_name\"=\"retrostore-api-compat-candidate\" OR resource.label.\"service_name\"=\"retrostore-admin-candidate\")",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "resource.label.service_name",
                        "metric.label.response_code_class"
                      ]
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "requests/s",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Candidate p95 request latency",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" (resource.label.\"service_name\"=\"retrostore-api-compat-candidate\" OR resource.label.\"service_name\"=\"retrostore-admin-candidate\")",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_95",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "groupByFields": [
                        "resource.label.service_name"
                      ]
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "milliseconds",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 6,
        "width": 6,
        "height": 5,
        "widget": {
          "title": "Comparator evidence",
          "logsPanel": {
            "filter": "resource.type=\"cloud_run_job\"\nresource.labels.job_name=\"retrostore-hourly-comparator\"\njsonPayload.event=\"scheduled_comparison\"",
            "resourceNames": [
              "projects/trs-80"
            ]
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 6,
        "width": 6,
        "height": 5,
        "widget": {
          "title": "Candidate application errors",
          "logsPanel": {
            "filter": "resource.type=\"cloud_run_revision\"\njsonPayload.event=\"http_request\"\nseverity>=ERROR",
            "resourceNames": [
              "projects/trs-80"
            ]
          }
        }
      }
    ]
  }
}
